{
  "manifest_version": 2,
  "name": "Netflix Household Bypass",
  "version": "2.2",
  "description": "Hides household overlays on Netflix browse and watch pages without blocking player requests.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "*://*.netflix.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [{
    "matches": ["*://*.netflix.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "netflix-household-no-more@yourdomain.com",
      "strict_min_version": "113.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
